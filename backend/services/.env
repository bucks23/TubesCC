# .env file for Flask application
# Copy this to .env in your Flask project root

# Database Configuration
DATABASE_URL=postgresql://hotel_cc:password@localhost/hotel_cc

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://remarkable-amazement-production.up.railway.app 

# Security (for production)
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Lax